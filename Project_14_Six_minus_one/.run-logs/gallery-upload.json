":3,"penalty":3,"description":"Static signs of initial-load interruptions can break task continuity and increase cognitive load.","suggestion":"Avoid initial dialogs, sticky prompts, overlays, and assertive notices that compete with the main task; this check does not simulate all focus or input-triggered changes.","evidence":{"primary_region":"header","interrupting_element_count":0,"max_interrupt_score":0,"js_interruption_signal_count":5,"severe_interrupt_covers_primary":false,"elements":[]},"locations":[{"summary":"scripted interruption signal","html_snippet":"/*!\n * baguetteBox.js\n * @author  feimosi\n * @version 1.11.1\n * @url https://github.com/feimosi/baguetteBox.js\n */\n!function(e,t){\"use strict\";\"function\"==typeof define&&define.amd","interrupt_type":"script"}],"id":"issue_ei_1","detector":"Excessive Interruptions","rule":{"id":"EI-1","name":"Excessive Interruptions"},"category":"motion","target":{"selector":"","elementType":"","textSnippet":"","boundingBox":null},"metrics":{"primary_region":"header","interrupting_element_count":0,"max_interrupt_score":0,"js_interruption_signal_count":5,"severe_interrupt_covers_primary":false,"elements":[]},"threshold":{"maxOverlayViewportShare":0.2},"interpretation":{"confidence":"low","heuristicBasis":"Overlay/modal/sticky heuristics and JS interruption regex signals."},"evidence_text":"primary_region: header; interrupting_element_count: 0; max_interrupt_score: 0; js_interruption_signal_count: 5","explanation":"Static signs of initial-load interruptions can break task continuity and increase cognitive load.","recommendations":["Avoid initial dialogs, sticky prompts, overlays, and assertive notices that compete with the main task; this check does not simulate all focus or input-triggered changes."],"standards":{"cogaPatterns":["Limit Interruptions"],"isoPrinciples":["Satisfaction"]},"highlight":{"strategy":"outline","color":"#3b82f6"},"issue_object":{"id":"issue_ei_1","detector":"Excessive Interruptions","rule":{"id":"EI-1","name":"Excessive Interruptions"},"category":"motion","target":{"selector":"","elementType":"","textSnippet":"","boundingBox":null},"metrics":{"primary_region":"header","interrupting_element_count":0,"max_interrupt_score":0,"js_interruption_signal_count":5,"severe_interrupt_covers_primary":false,"elements":[]},"threshold":{"maxOverlayViewportShare":0.2},"interpretation":{"confidence":"low","heuristicBasis":"Overlay/modal/sticky heuristics and JS interruption regex signals."},"evidence":"primary_region: header; interrupting_element_count: 0; max_interrupt_score: 0; js_interruption_signal_count: 5","explanation":"Static signs of initial-load interruptions can break task continuity and increase cognitive load.","recommendations":["Avoid initial dialogs, sticky prompts, overlays, and assertive notices that compete with the main task; this check does not simulate all focus or input-triggered changes."],"standards":{"cogaPatterns":["Limit Interruptions"],"isoPrinciples":["Satisfaction"]},"highlight":{"strategy":"outline","color":"#3b82f6"}},"issue_category_key":"motion","issue_category_label":"Motion Issues","issue_category":{"key":"motion","label":"Motion Issues"}}],"metadata":{"detector":"Excessive Interruptions","selector_file":"excessive_interruptions.py","implemented_rules":["EI-1"],"total_penalty":3}}],"run":{"run_id":"010213ca3fdd4754937bb4d1b97d7efb","created_at":"2026-05-19T17:45:09+10:00","source_name":"FEWD-project5-interactive-photo-gallery.zip","eye_tracking_summary":{"available":false},"visual_complexity_summary":{"available":false}},"html_content":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head><base href=\"/preview/74452ec4639649508d23c25e8901c05c/FEWD-project5-interactive-photo-gallery/\">\n    <meta charset=\"UTF-8\" />\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Interactive Photo Gallery</title>\n\n    <!-- Linking the CSS stylesheet -->\n    <link rel=\"stylesheet\" href=\"css/normalize.css\" />\n    <link rel=\"stylesheet\" href=\"css/styles.css\" />\n    <link rel=\"stylesheet\" href=\"css/baguetteBox.min.css\" />\n\n    <!-- Linking external fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,500;1,300&display=swap\"\n      rel=\"stylesheet\"\n    />\n\n    <!-- Linking JS scripts -->\n    <script defer src=\"js/baguetteBox.min.js\"></script>\n    <script defer src=\"js/search.js\"></script>\n    <script defer src=\"js/app.js\"></script>\n  </head>\n  <body>\n    <header>\n      <h1 id=\"logo\">Interactive Photo Gallery</h1>\n    </header>\n\n    <!-- Establishing the grid -->\n    <div class=\"grid gallery\">\n      <!-- Creating the top search input field -->\n      <input\n        type=\"text\"\n        placeholder=\"Search\"\n        name=\"search\"\n        onkeyup=\"search_gallery()\"\n        id=\"searchbar\"\n      />\n\n      <!-- Image gallery -->\n      <a\n        href=\"img/01.jpg\"\n        class=\"galleryImage\"\n        data-caption=\"I love hay bales. Took this snap on a drive through the countryside past some straw fields.\"\n        title=\"Hay Bales\"\n      >\n        <img src=\"img/thumbnails/01.jpg\" alt=\"Hay Bales\" />\n      </a>\n\n      <a\n        href=\"img/02.jpg\"\n        class=\"galleryImage\"\n        data-caption=\"The lake was so calm today. We had a great view of the snow on the mountains from here.\"\n      >\n        <img src=\"img/thumbnails/02.jpg\" alt=\"Lake\" title=\"Lake\" />\n      </a>\n\n      <a\n        href=\"img/03.jpg\"\n        class=\"galleryImage\"\n        data-caption=\"I hiked to the top of the mountain and got this picture of the canyon and trees below.\"\n      >\n        <img src=\"img/thumbnails/03.jpg\" alt=\"Canyon\" title=\"Canyon\" />\n      </a>\n\n      <a\n        href=\"img/04.jpg\"\n        class=\"galleryImage\"\n        data-caption=\"It was amazing to see an iceberg up close, it was so cold but didn¡¯t snow today. \"\n      >\n        <img src=\"img/thumbnails/04.jpg\" alt=\"Iceberg\" title=\"Iceberg\" />\n      </a>\n\n      <a\n        href=\"img/05.jpg\"\n        class=\"galleryImage\"\n        data-caption=\"The red cliffs were beautiful. It was really hot in the desert but we did a lot of walking through the canyons.\"\n      >\n        <img src=\"img/thumbnails/05.jpg\" alt=\"Desert\" title=\"Desert\" />\n      </a>\n\n      <a\n        href=\"img/06.jpg\"\n        class=\"galleryImage\"\n        data-caption=\"Fall is coming, I love when the leaves on the trees start to change color.\"\n      >\n        <img src=\"img/thumbnails/06.jpg\" alt=\"Fall\" title=\"Fall\" />\n      </a>\n\n      <a\n        href=\"img/07.jpg\"\n        class=\"galleryImage\"\n        data-caption=\"I drove past this plantation yesterday, everything is so green!\"\n      >\n        <img src=\"img/thumbnails/07.jpg\" alt=\"Plantation\" title=\"Plantation\" />\n      </a>\n\n      <a\n        href=\"img/08.jpg\"\n        class=\"galleryImage\"\n        data-caption=\"My summer vacation to the Oregon Coast. I love the sandy dunes!\"\n      >\n        <img src=\"img/thumbnails/08.jpg\" alt=\"Dunes\" title=\"Dunes\" />\n      </a>\n\n      <a\n        href=\"img/09.jpg\"\n        class=\"galleryImage\"\n        data-caption=\"We enjoyed a quiet stroll down this countryside lane.\"\n      >\n        <img\n          src=\"img/thumbnails/09.jpg\"\n          alt=\"Countryside Lane\"\n          title=\"Countryside Lane\"\n        />\n      </a>\n\n      <a\n        href=\"img/10.jpg\"\n        class=\"galleryImage\"\n        data-caption=\"Sunset at the coast! The sky turned a lovely shade of orange.\"\n      >\n        <img src=\"img/thumbnails/10.jpg\" alt=\"Sunset\" title=\"Sunset\" />\n      </a>\n\n      <a\n        href=\"img/11.jpg\"\n        class=\"galleryImage\"\n        data-caption=\"I did a tour of a cave today and the view of the landscape below was breathtaking.\"\n      >\n        <img src=\"img/thumbnails/11.jpg\" alt=\"Cave\" title=\"Cave\" />\n      </a>\n\n      <a\n        href=\"img/12.jpg\"\n        class=\"galleryImage\"\n        data-caption=\"I walked through this meadow of bluebells and got a good view of the snow on the mountain before the fog came in.\"\n      >\n        <img src=\"img/thumbnails/12.jpg\" alt=\"Bluebells\" title=\"Bluebells\" />\n      </a>\n    </div>\n  </body>\n</html>\n","baseline_run_id":null,"resource_bundle":{"entry_name":"FEWD-project5-interactive-photo-gallery/index.html","css_file_count":3,"js_file_count":3,"css_files":["FEWD-project5-interactive-photo-gallery/css/baguetteBox.min.css","FEWD-project5-interactive-photo-gallery/css/normalize.css","FEWD-project5-interactive-photo-gallery/css/styles.css"],"js_files":["FEWD-project5-interactive-photo-gallery/js/app.js","FEWD-project5-interactive-photo-gallery/js/baguetteBox.min.js","FEWD-project5-interactive-photo-gallery/js/search.js"],"preview_id":"74452ec4639649508d23c25e8901c05c","preview_url":"/preview/74452ec4639649508d23c25e8901c05c/FEWD-project5-interactive-photo-gallery/index.html"},"analysis_id":"010213ca3fdd4754937bb4d1b97d7efb","preview_id":"74452ec4639649508d23c25e8901c05c","preview_url":"/preview/74452ec4639649508d23c25e8901c05c/FEWD-project5-interactive-photo-gallery/index.html"}
